---
import {
  DatabaseIcon,
  HouseIcon,
  MagicWandIcon,
  MagnifyingGlassIcon,
  PencilSimpleLineIcon,
  SquaresFourIcon,
  TagIcon,
  TrashIcon,
  UserIcon,
} from "@phosphor-icons/react";
import Layout from "@/layouts/Layout.astro";
import "@/styles/brand-card.css";
---

<Layout
  title="Tahona Brand Card"
  description="Tarjeta visual del sistema de marca de Tahona."
  noindex={true}
>
  <main class="brand-card-shell" aria-label="Tahona brand card">
    <section class="brand-card-canvas" aria-label="Sistema visual de Tahona">
      <div class="palette-stack" aria-label="Paleta de color">
        <article class="palette-card palette-card-primary">
          <div class="palette-header">
            <span>Primario</span>
            <span>#245840</span>
          </div>
          <div class="swatch-row" aria-hidden="true">
            <span style="background:#00180f"></span>
            <span style="background:#062819"></span>
            <span style="background:#0d3825"></span>
            <span style="background:#1b4530"></span>
            <span style="background:#245840"></span>
            <span style="background:#3f7058"></span>
            <span style="background:#628d73"></span>
            <span style="background:#83b898"></span>
            <span style="background:#a2d5b8"></span>
            <span style="background:#c9f7db"></span>
            <span style="background:#e3ffed"></span>
          </div>
        </article>

        <article class="palette-card palette-card-secondary">
          <div class="palette-header">
            <span>Secundario</span>
            <span>#2D6A4F</span>
          </div>
          <div class="swatch-row" aria-hidden="true">
            <span style="background:#00180f"></span>
            <span style="background:#073020"></span>
            <span style="background:#0c4931"></span>
            <span style="background:#2d6a4f"></span>
            <span style="background:#4a8b6a"></span>
            <span style="background:#6da783"></span>
            <span style="background:#8ac29f"></span>
            <span style="background:#a8dfbf"></span>
            <span style="background:#c5f8da"></span>
            <span style="background:#e2ffed"></span>
          </div>
        </article>

        <article class="palette-card palette-card-surface">
          <div class="palette-header">
            <span>Superficie</span>
            <span>#F0F7F3</span>
          </div>
          <div class="swatch-row" aria-hidden="true">
            <span style="background:#0f1713"></span>
            <span style="background:#1f2823"></span>
            <span style="background:#3a443f"></span>
            <span style="background:#56605b"></span>
            <span style="background:#707b75"></span>
            <span style="background:#8e9993"></span>
            <span style="background:#adb8b1"></span>
            <span style="background:#cbd8cf"></span>
            <span style="background:#e5f0e9"></span>
            <span style="background:#f0f7f3"></span>
          </div>
        </article>

        <article class="palette-card palette-card-neutral">
          <div class="palette-header">
            <span>Neutral</span>
            <span>#1F1F1F</span>
          </div>
          <div class="swatch-row" aria-hidden="true">
            <span style="background:#050505"></span>
            <span style="background:#171717"></span>
            <span style="background:#2b2b2b"></span>
            <span style="background:#424242"></span>
            <span style="background:#5e5e5e"></span>
            <span style="background:#797979"></span>
            <span style="background:#a0a0a0"></span>
            <span style="background:#c5c5c5"></span>
            <span style="background:#e7e7e7"></span>
            <span style="background:#f7f7f7"></span>
          </div>
        </article>
      </div>

      <article class="sample-card type-card headline-card">
        <div class="card-meta">
          <span>Headline</span>
          <span>Plus Jakarta Sans</span>
        </div>
        <p class="type-sample heading-sample">Aa</p>
      </article>

      <article class="sample-card controls-card" aria-label="Botones">
        <div class="button-grid">
          <button class="button-sample button-primary" type="button">Primario</button>
          <button class="button-sample button-secondary" type="button">Secundario</button>
          <button class="button-sample button-inverted" type="button">Invertido</button>
          <button class="button-sample button-outlined" type="button">Borde</button>
        </div>
      </article>

      <article class="sample-card search-card" aria-label="Campo de busqueda">
        <label class="search-control">
          <MagnifyingGlassIcon aria-hidden="true" size={22} weight="bold" />
          <span>Buscar</span>
        </label>
      </article>

      <article class="sample-card type-card body-card">
        <div class="card-meta">
          <span>Body</span>
          <span>Geist</span>
        </div>
        <p class="type-sample body-sample">Aa</p>
      </article>

      <article class="sample-card rhythm-card" aria-label="Ritmo de contenido">
        <div class="rhythm-lines" aria-hidden="true">
          <span class="line line-primary"></span>
          <span class="line line-secondary"></span>
          <span class="line line-neutral"></span>
        </div>
      </article>

      <article class="sample-card nav-card" aria-label="Navegacion">
        <div class="nav-pill">
          <span class="nav-icon active"><HouseIcon aria-hidden="true" size={21} weight="bold" /></span>
          <span class="nav-icon"><MagnifyingGlassIcon aria-hidden="true" size={21} weight="bold" /></span>
          <span class="nav-icon"><UserIcon aria-hidden="true" size={21} weight="bold" /></span>
        </div>
      </article>

      <article class="sample-card type-card label-card">
        <div class="card-meta">
          <span>Label</span>
          <span>Geist</span>
        </div>
        <p class="type-sample label-sample">Aa</p>
      </article>

      <div class="tool-pair" aria-label="Controles compactos">
        <article class="sample-card icon-tile">
          <button class="square-action" type="button" aria-label="Editar">
            <PencilSimpleLineIcon aria-hidden="true" size={26} weight="bold" />
          </button>
        </article>

        <article class="sample-card label-tile">
          <button class="label-action" type="button">
            <PencilSimpleLineIcon aria-hidden="true" size={20} weight="bold" />
            <span>Etiqueta</span>
          </button>
        </article>
      </div>

      <article class="sample-card action-card" aria-label="Acciones">
        <div class="action-row">
          <span class="round-action primary"><MagicWandIcon aria-hidden="true" size={21} weight="bold" /></span>
          <span class="round-action secondary"><SquaresFourIcon aria-hidden="true" size={21} weight="bold" /></span>
          <span class="round-action dark"><TagIcon aria-hidden="true" size={21} weight="bold" /></span>
          <span class="round-action danger"><TrashIcon aria-hidden="true" size={21} weight="bold" /></span>
          <span class="round-action database"><DatabaseIcon aria-hidden="true" size={21} weight="bold" /></span>
        </div>
      </article>
    </section>
  </main>
</Layout>
