---
import Layout from "@/layouts/Layout.astro";
import SkipLink from "@/components/SkipLink.astro";
import { Navbar } from "@/components/sections/Navbar";
import Footer from "@/components/sections/Footer.astro";
import { primaryCtaBaseClass } from "@/components/ui/cta-styles";
import { DEFAULT_LOCALE, getLocalizedPath } from "@/i18n/routing";

const homePath = getLocalizedPath(DEFAULT_LOCALE, "home");
const title = "Página no encontrada | Tahona";
const description =
  "La página solicitada no existe o ha cambiado de ubicación. Desde Tahona se puede volver al inicio.";
---

<Layout
  locale="es"
  pageKey="home"
  title={title}
  description={description}
  canonical="https://tahona.ai/404"
  noindex
>
  <SkipLink locale="es" />
  <main
    id="main-content"
    class="relative flex min-h-screen flex-col overflow-x-hidden"
  >
    <Navbar client:load initialPath={Astro.url.pathname} locale="es" />
    <section class="relative flex flex-1 flex-col items-center justify-center overflow-hidden bg-surface px-6 py-24 sm:py-32">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-1/2 top-1/2 h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-100/50 blur-3xl"
      />
      <div class="relative flex flex-col items-center">
        <p class="font-mono text-sm font-medium uppercase tracking-[0.3em] text-brand-500">
          Error 404
        </p>
        <span
          aria-hidden="true"
          class="mt-6 font-heading text-8xl font-extrabold leading-none tracking-tight text-brand-700 sm:text-9xl"
        >
          404
        </span>
        <h1 class="mt-6 text-center font-heading text-2xl font-bold tracking-tight text-charcoal sm:text-3xl">
          Página no encontrada
        </h1>
        <p class="mt-4 max-w-md text-center text-base leading-7 text-gray-600 sm:text-lg">
          La página solicitada no existe o ha cambiado de ubicación.
        </p>
        <a
          href={homePath}
          class={`${primaryCtaBaseClass} mt-10 min-h-12 px-6 text-sm font-semibold`}
        >
          <span>Volver al inicio</span>
        </a>
      </div>
    </section>
    <Footer locale="es" />
  </main>
</Layout>
