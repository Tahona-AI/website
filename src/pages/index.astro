---
import Layout from "../layouts/Layout.astro";
import SkipLink from "@/components/SkipLink.astro";
import { Navbar } from "@/components/sections/Navbar";
import { Hero } from "@/components/sections/Hero";
import { Services } from "@/components/sections/Services";
import SuccessStory from "@/components/sections/SuccessStory.astro";
import { HowWeWork } from "@/components/sections/HowWeWork";
import WhyTahona from "@/components/sections/WhyTahona.astro";
import { Contact } from "@/components/sections/Contact";
import Footer from "@/components/sections/Footer.astro";
---

<Layout>
  <SkipLink />
  <main
    id="main-content"
    class="relative flex min-h-screen flex-col overflow-x-hidden"
  >
    <Navbar client:load />
    <Hero client:load />
    <Services client:visible />
    <SuccessStory />
    <HowWeWork client:visible />
    <WhyTahona />
    <Contact client:load />
    <Footer />
  </main>
</Layout>
