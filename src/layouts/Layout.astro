---
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";
import {
  DEFAULT_LOCALE,
  getRouteKeyFromPath,
  LOCALE_DETAILS,
} from "@/i18n/routing";
import type { Locale, RouteKey } from "@/i18n/routing";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  locale?: Locale;
  noindex?: boolean;
  nofollow?: boolean;
  pageKey?: RouteKey;
}

const {
  title,
  description,
  image,
  canonical,
  locale = DEFAULT_LOCALE,
  noindex,
  nofollow,
  pageKey = getRouteKeyFromPath(Astro.url.pathname),
} = Astro.props;
---

<!doctype html>
<html lang={LOCALE_DETAILS[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/images/logos/tahona-favicon.svg" />
    <link rel="shortcut icon" href="/images/logos/tahona-favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Tahona" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2D6A4F" />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      locale={locale}
      noindex={noindex}
      nofollow={nofollow}
      pageKey={pageKey}
    />

    <!-- Structured Data -->
    <StructuredData locale={locale} pageKey={pageKey} />
  </head>
  <body class="font-body antialiased">
    <slot />
  </body>
</html>
