---
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-sans/700.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";
import {
  DEFAULT_LOCALE,
  getRouteKeyFromPath,
  LOCALE_DETAILS,
} from "@/i18n/routing";
import type { Locale, RouteKey } from "@/i18n/routing";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  locale?: Locale;
  noindex?: boolean;
  nofollow?: boolean;
  pageKey?: RouteKey;
}

const {
  title,
  description,
  image,
  canonical,
  locale = DEFAULT_LOCALE,
  noindex,
  nofollow,
  pageKey = getRouteKeyFromPath(Astro.url.pathname),
} = Astro.props;

const pageWipeAnimation = {
  forwards: {
    old: {
      name: "tahona-page-hold",
      duration: "380ms",
      easing: "linear",
      fillMode: "both",
    },
    new: {
      name: "tahona-page-wipe-in",
      duration: "380ms",
      easing: "cubic-bezier(0.65, 0, 0.35, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "tahona-page-hold",
      duration: "380ms",
      easing: "linear",
      fillMode: "both",
    },
    new: {
      name: "tahona-page-wipe-in",
      duration: "380ms",
      easing: "cubic-bezier(0.65, 0, 0.35, 1)",
      fillMode: "both",
    },
  },
};
---

<!doctype html>
<html
  lang={LOCALE_DETAILS[locale].htmlLang}
  transition:name="root"
  transition:animate={pageWipeAnimation}
>
  <head>
    <meta charset="utf-8" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/images/logos/tahona-favicon.svg" />
    <link rel="shortcut icon" href="/images/logos/tahona-favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Tahona" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2D6A4F" />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      locale={locale}
      noindex={noindex}
      nofollow={nofollow}
      pageKey={pageKey}
    />

    <!-- Structured Data -->
    <StructuredData locale={locale} pageKey={pageKey} />
    <ClientRouter />
  </head>
  <body class="font-body antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @property --tahona-wipe-front {
    syntax: "<percentage>";
    inherits: false;
    initial-value: -42%;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) {
    z-index: 1;
  }

  ::view-transition-new(root) {
    z-index: 2;
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 var(--tahona-wipe-front),
      transparent calc(var(--tahona-wipe-front) + 42%),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 var(--tahona-wipe-front),
      transparent calc(var(--tahona-wipe-front) + 42%),
      transparent 100%
    );
  }

  @keyframes tahona-page-hold {
    from {
      opacity: 1;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes tahona-page-wipe-in {
    from {
      --tahona-wipe-front: -42%;
    }
    to {
      --tahona-wipe-front: 100%;
    }
  }
</style>
