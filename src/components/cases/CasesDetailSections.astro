---
import { getCaseStudies } from "@/components/cases/cases-data";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE, getLocalizedHashPath } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const caseStudies = getCaseStudies(locale);
const copy = getContent(locale).casesPage.section;
---

<section id="casos" class="relative overflow-hidden bg-white py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-500 text-pretty">
        {copy.text}
      </p>
    </div>

    <div class="mt-16 space-y-16">
      {caseStudies.map((caseStudy, caseIndex) => {
        const imageFirst = caseIndex % 2 === 1;

        return (
          <article
            id={caseStudy.id}
            aria-labelledby={`case-title-${caseStudy.id}`}
            class="relative scroll-mt-28 border-t border-gray-200 pt-16 first:border-t-0 first:pt-0"
          >
            {caseStudy.legacyId && (
              <span
                id={caseStudy.legacyId}
                class="absolute inset-x-0 top-0 h-px scroll-mt-28"
                aria-hidden="true"
              ></span>
            )}
            <div
              class:list={[
                "grid gap-10 lg:items-center lg:gap-14",
                imageFirst
                  ? "lg:grid-cols-[minmax(18rem,1fr)_minmax(0,2fr)]"
                  : "lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]",
              ]}
            >
              <div class:list={[imageFirst && "lg:order-2"]}>
                <p class="text-sm font-semibold text-brand-700">
                  {caseStudy.marker} / {String(caseStudies.length).padStart(2, "0")}
                </p>
                <p class="mt-5 text-sm font-medium text-gray-500">
                  {caseStudy.sector}
                </p>
                <h3 class="mt-3 font-heading text-3xl font-semibold text-gray-900 text-balance">
                  <span id={`case-title-${caseStudy.id}`}>
                    {caseStudy.title}
                  </span>
                </h3>

                <div class="mt-8 space-y-7">
                  <div class="border-l-2 border-brand-200 pl-5">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-700">
                      {copy.challengeLabel}
                    </p>
                    <p class="mt-2 max-w-2xl text-base leading-8 text-gray-600 text-pretty">
                      {caseStudy.challenge}
                    </p>
                  </div>

                  <div class="border-l-2 border-gray-200 pl-5">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">
                      {copy.interventionLabel}
                    </p>
                    <p class="mt-2 max-w-2xl text-base leading-8 text-gray-600 text-pretty">
                      {caseStudy.intervention}
                    </p>
                  </div>
                </div>

                <div class="mt-8">
                  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">
                    {copy.enablesLabel}
                  </p>
                  <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-600">
                    {caseStudy.enables.map((enablement) => (
                      <li class="grid grid-cols-[0.65rem_1fr] gap-3">
                        <span class="mt-2 size-1.5 rounded-full bg-brand-500"></span>
                        <span>{enablement}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-8">
                  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-gray-500">
                    {copy.relatedCapabilitiesLabel}
                  </p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {caseStudy.relatedCapabilities.map((capability) => (
                      <a
                        href={getLocalizedHashPath(
                          locale,
                          "services",
                          capability.hash,
                        )}
                        class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white/78 px-3.5 py-1.5 text-xs leading-5 text-gray-700 transition-colors hover:border-brand-200 hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                      >
                        <span class="size-1.5 rounded-full bg-brand-500"></span>
                        {capability.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <div
                class:list={[
                  "relative min-h-72 overflow-hidden rounded-[1.75rem] border border-gray-200/80 bg-[radial-gradient(circle_at_22%_18%,rgba(45,106,79,0.15),transparent_32%),radial-gradient(circle_at_78%_76%,rgba(64,145,108,0.13),transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.78),rgba(255,255,255,0.3))] p-4 shadow-[0_26px_70px_-54px_rgba(31,31,31,0.6),inset_0_1px_0_rgba(255,255,255,0.82)] lg:min-h-[22rem]",
                  imageFirst && "lg:order-1",
                ]}
              >
                <div class="flex h-full min-h-64 items-center justify-center">
                  <img
                    src={caseStudy.visualSrc}
                    alt={caseStudy.visualAlt}
                    class="relative h-full w-full scale-[1.08] object-contain p-3 sm:p-4"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
