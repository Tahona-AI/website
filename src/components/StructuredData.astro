---
import { getCaseStudies } from "@/components/cases/cases-data";
import { getIndustriesFaq } from "@/components/industries/industries-faq";
import { getIndustryItems } from "@/components/industries/industry-data";
import { getServiceFamilies } from "@/components/services/service-families";
import { getServicesFaq } from "@/components/services/services-faq";
import { getContent } from "@/i18n/content";
import {
  DEFAULT_LOCALE,
  getAbsoluteUrl,
  getRouteKeyFromPath,
  LOCALE_DETAILS,
} from "@/i18n/routing";
import type { Locale, RouteKey } from "@/i18n/routing";

const SITE_ORIGIN = "https://tahona.ai";

interface Props {
  locale?: Locale;
  pageKey?: RouteKey;
}

const { locale = DEFAULT_LOCALE, pageKey } = Astro.props;
const routeKey = pageKey ?? getRouteKeyFromPath(Astro.url.pathname);
const content = getContent(locale);
const pageData = content.metadata[routeKey];
const homePage = content.metadata.home;
const canonicalURL = getAbsoluteUrl(locale, routeKey);
const homeURL = getAbsoluteUrl(locale, "home");
const schemaLanguage = LOCALE_DETAILS[locale].schemaLanguage;
const serviceFamilies = getServiceFamilies(locale);
const servicesFaq = getServicesFaq(locale);
const industryItems = getIndustryItems(locale);
const primaryIndustryItems = industryItems.filter(
  (industry) => industry.level === "primary",
);
const secondaryIndustryItems = industryItems.filter(
  (industry) => industry.level === "secondary",
);
const industriesFaq = getIndustriesFaq(locale);
const caseStudies = getCaseStudies(locale);

const organizationId = `${SITE_ORIGIN}/#organization`;
const websiteId = `${SITE_ORIGIN}/#website`;
const breadcrumbId = `${canonicalURL}#breadcrumb`;
const webpageId = `${canonicalURL}#webpage`;

const organizationSchema = {
  "@type": "Organization",
  "@id": organizationId,
  name: "Tahona",
  url: getAbsoluteUrl(DEFAULT_LOCALE, "home"),
  logo: new URL("/images/logos/tahona-favicon.svg", SITE_ORIGIN).href,
  description: content.structuredData.organizationDescription,
  knowsAbout: content.structuredData.knowsAbout,
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  name: "Tahona",
  url: homeURL,
  description: homePage.description,
  inLanguage: schemaLanguage,
  publisher: {
    "@id": organizationId,
  },
};

const breadcrumbItems =
  routeKey === "home"
    ? [
        {
          "@type": "ListItem",
          position: 1,
          name: homePage.name,
          item: homeURL,
        },
      ]
    : [
        {
          "@type": "ListItem",
          position: 1,
          name: homePage.name,
          item: homeURL,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: pageData.name,
          item: canonicalURL,
        },
      ];

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": breadcrumbId,
  itemListElement: breadcrumbItems,
};

const webPageSchema = {
  "@type": "WebPage",
  "@id": webpageId,
  url: canonicalURL,
  name: pageData.title,
  description: pageData.description,
  inLanguage: schemaLanguage,
  isPartOf: {
    "@id": websiteId,
  },
  publisher: {
    "@id": organizationId,
  },
  breadcrumb: {
    "@id": breadcrumbId,
  },
};

const servicesSchema =
  routeKey === "services"
    ? [
        {
          "@type": "Service",
          "@id": `${canonicalURL}#services`,
          name: content.structuredData.serviceSchemaName,
          description: pageData.description,
          provider: {
            "@id": organizationId,
          },
          hasOfferCatalog: {
            "@type": "OfferCatalog",
            name: content.structuredData.serviceCatalogName,
            itemListElement: serviceFamilies.map((family) => ({
              "@type": "OfferCatalog",
              name: family.title,
              description: family.description,
              itemListElement: family.services.map((service) => ({
                "@type": "Offer",
                itemOffered: {
                  "@type": "Service",
                  name: service.title,
                  description: service.summary,
                  url: `${canonicalURL}#${service.id}`,
                },
              })),
            })),
          },
        },
        {
          "@type": "FAQPage",
          "@id": `${canonicalURL}#faq`,
          mainEntity: servicesFaq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : [];

const industriesSchema =
  routeKey === "industries"
    ? [
        {
          "@type": "ItemList",
          "@id": `${canonicalURL}#primary-industries`,
          name: content.structuredData.primaryIndustryListName,
          itemListElement: primaryIndustryItems.map((industry, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: industry.title,
            description: industry.summary,
            url: `${canonicalURL}#${industry.id}`,
          })),
        },
        {
          "@type": "ItemList",
          "@id": `${canonicalURL}#secondary-industries`,
          name: content.structuredData.secondaryIndustryListName,
          itemListElement: secondaryIndustryItems.map((industry, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: industry.title,
            description: industry.summary,
            url: `${canonicalURL}#${industry.id}`,
          })),
        },
        {
          "@type": "FAQPage",
          "@id": `${canonicalURL}#faq`,
          mainEntity: industriesFaq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : [];

const casesSchema =
  routeKey === "cases"
    ? [
        {
          "@type": "ItemList",
          "@id": `${canonicalURL}#cases`,
          name: content.structuredData.casesListName,
          itemListElement: caseStudies.map((caseStudy, index) => ({
            "@type": "ListItem",
            position: index + 1,
            item: {
              "@type": "CreativeWork",
              name: caseStudy.title,
              description: `${caseStudy.challenge} ${caseStudy.intervention}`,
              about: caseStudy.relatedCapabilities.map(
                (capability) => capability.label,
              ),
              url: `${canonicalURL}#${caseStudy.id}`,
            },
          })),
        },
      ]
    : [];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    websiteSchema,
    webPageSchema,
    breadcrumbSchema,
    ...servicesSchema,
    ...industriesSchema,
    ...casesSchema,
  ],
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schemaGraph)}
/>
