---
import Layout from "@/layouts/Layout.astro";
import SkipLink from "@/components/SkipLink.astro";
import { Navbar } from "@/components/sections/Navbar";
import { Hero } from "@/components/sections/Hero";
import { Contact } from "@/components/sections/Contact";
import Footer from "@/components/sections/Footer.astro";
import ServicesPillars from "@/components/services/ServicesPillars.astro";
import ServiceDetailSections from "@/components/services/ServiceDetailSections.astro";
import EngagementModes from "@/components/services/EngagementModes.astro";
import ServicesFAQ from "@/components/services/ServicesFAQ.astro";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const hero = getContent(locale).servicesPage.hero;
const heroTitle = hero.titleLines.join(" ");
---

<Layout locale={locale} pageKey="services">
  <SkipLink locale={locale} />
  <main
    id="main-content"
    class="relative flex min-h-screen flex-col overflow-x-hidden"
  >
    <Navbar client:load initialPath={Astro.url.pathname} locale={locale} />
    <Hero
      client:load
      locale={locale}
      title={heroTitle}
      description={hero.description}
      primaryLabel={hero.primaryLabel}
      primaryHref={hero.primaryHref}
      secondaryLabel={hero.secondaryLabel}
      secondaryHref={hero.secondaryHref}
    />
    <ServicesPillars locale={locale} />
    <ServiceDetailSections locale={locale} />
    <EngagementModes locale={locale} />
    <ServicesFAQ locale={locale} />
    <Contact client:load locale={locale} />
    <Footer locale={locale} />
  </main>
</Layout>
