---
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/geist-sans/400.css";
import "@fontsource/geist-sans/500.css";
import "@fontsource/geist-sans/600.css";
import "@fontsource/geist-mono/400.css";
import "./corporate.css";
import HeadingLines from "./HeadingLines.astro";
import { copy, type Locale } from "./copy";
import slides from "./slides.json";

interface Props { locale?: Locale; }
const { locale = "es" } = Astro.props;
const c = copy[locale];
const languages = [
  { locale: "es", lang: "es", name: "Español", short: "ES", path: "/" },
  { locale: "en", lang: "en", name: "English", short: "EN", path: "/en/" },
  { locale: "zh", lang: "zh-CN", name: "中文", short: "中文", path: "/zh/" },
];
const language = languages.find(item => item.locale === locale)!;
const slideCaption = (index: number) => c.slides[index].caption + (index === 2 ? " · krzhck / Unsplash" : index === 5 ? " · Tanya Barrow / Unsplash" : index === 6 ? " · NASA / Apollo 17" : "");
const formLabels = [["name", c.contact.name], ["company", c.contact.company], ["email", c.contact.email], ["message", c.contact.message]];
---

<!doctype html>
<html lang={language.lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Restore only a pending language change; normal links keep native scrolling.
      (() => {
        try {
          const saved = sessionStorage.getItem("tahona-language-scroll");
          if (!saved) return;
          sessionStorage.removeItem("tahona-language-scroll");
          const position = JSON.parse(saved);
          if (position.path !== location.pathname || !Number.isFinite(position.y) || !Number.isFinite(position.x)) return;
          const previousRestoration = history.scrollRestoration;
          history.scrollRestoration = "manual";
          document.documentElement.setAttribute("data-language-restoring", "");
          document.addEventListener("DOMContentLoaded", async () => {
            await document.fonts.ready;
            requestAnimationFrame(() => {
              window.scrollTo({ left: position.x, top: position.y, behavior: "instant" });
              document.documentElement.removeAttribute("data-language-restoring");
              history.scrollRestoration = previousRestoration;
            });
          }, { once: true });
        } catch {
          document.documentElement.removeAttribute("data-language-restoring");
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#123422" />
    <meta name="description" content={c.metaDescription} />
    <title>{c.metaTitle}</title>
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={slides[0].src} imagesrcset={slides[0].srcSet} imagesizes="100vw" as="image" />
    {languages.map(item => <link rel="alternate" hreflang={item.lang} href={item.path} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{c.nav.skip}</a>
    <header class="site-header">
      <div class="utility-bar">
        <div class="shell"><span>{c.utility}</span><a href="#internacional">{c.regions}<span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="nav-row shell">
        <a href="#inicio" class="brand" aria-label={c.nav.home}>
          <span class="brand-mark"><img src="/images/logos/tahona-mark-green.svg" alt="" width="68" height="68" /></span>
          <span>Tahona<span class="brand-ai">AI</span></span>
        </a>
        <nav class="desktop-nav" aria-label={c.nav.mainLabel}>
          <div class="nav-disclosure">
            <button aria-expanded="false" aria-controls="services-menu" data-menu-trigger>{c.nav.capabilities}<span aria-hidden="true">⌄</span></button>
            <div id="services-menu" class="mega-menu" hidden>
              <div><span class="eyebrow">{c.nav.menuEyebrow}</span><h2><HeadingLines text={c.nav.menuTitle} /></h2><a href="#capacidades">{c.nav.menuExplore} <span aria-hidden="true">↗</span></a></div>
              <ul>{c.capabilities.map(item => <li><a href={`#capacidad-${item.number}`}><span>{item.number}</span>{item.title}<span aria-hidden="true">↗</span></a></li>)}</ul>
            </div>
          </div>
          <a href="#industrias">{c.nav.industries}</a>
          <a href="#casos">{c.nav.cases}</a>
          <a href="#perspectivas">{c.nav.perspectives}</a>
          <a href="#nosotros">{c.nav.about}</a>
        </nav>
        <details class="language-picker">
          <summary aria-label={c.languageLabel}>
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" /><ellipse cx="10" cy="10" rx="3" ry="7.5" /><path d="M2.5 10h15" /></svg>
            {language.short}<span aria-hidden="true">⌄</span>
          </summary>
          <ul>{languages.map(item => <li><a href={item.path} lang={item.lang} hreflang={item.lang} data-language-switch aria-current={locale === item.locale ? "page" : undefined}>{item.name}<span aria-hidden="true">{locale === item.locale ? "✓" : "↗"}</span></a></li>)}</ul>
        </details>
        <a class="nav-contact" href="#contacto">{c.nav.contact}<span aria-hidden="true">↗</span></a>
        <button class="mobile-toggle" aria-label={c.nav.openMenu} aria-expanded="false" aria-controls="mobile-nav" data-open-label={c.nav.openMenu} data-close-label={c.nav.closeMenu}><span></span><span></span></button>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label={c.nav.mobileLabel} hidden>
        <a href="#capacidades">{c.nav.capabilities}</a><a href="#industrias">{c.nav.industries}</a><a href="#casos">{c.nav.cases}</a><a href="#perspectivas">{c.nav.perspectives}</a><a href="#nosotros">{c.nav.about}</a><a href="#contacto">{c.nav.contact} ↗</a>
      </nav>
    </header>
    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-heading" data-carousel data-pause-label={c.hero.pause} data-play-label={c.hero.play} style={`--slide-count:${slides.length}`}>
        <div class="hero-photo" role="group" aria-label={c.hero.carouselLabel}>
          {slides.map((slide, index) => <div class:list={["hero-slide", {"is-active":index === 0, "hero-slide-space":index === 6}]} data-slide data-motion-cycle={index === 0 ? "0" : undefined} aria-hidden={index !== 0} style={`--image-position:${slide.position};--mobile-image-position:${slide.mobilePosition};--image-fit:${slide.fit}`}>
            <img src={index === 0 ? slide.src : undefined} srcset={index === 0 ? slide.srcSet : undefined} data-image-src={index === 0 ? undefined : slide.src} data-image-srcset={index === 0 ? undefined : slide.srcSet} sizes="100vw" alt={c.slides[index].alt} width={slide.width} height={slide.height} fetchpriority={index === 0 ? "high" : "low"} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          </div>)}
        </div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="shell hero-content">
          <p class="eyebrow hero-enter">{c.hero.eyebrow}</p>
          <h1 id="hero-heading" class="hero-enter">{c.hero.line1}<br />{c.hero.line2}{locale === "zh" ? "" : " "}<span>{c.hero.accent}</span></h1>
          <p class="hero-description hero-enter">{c.hero.description}</p>
          <a class="button button-light hero-enter" href="#capacidades">{c.hero.cta}<span aria-hidden="true">↗</span></a>
          <div class="hero-bottom">
            <div class="hero-signature"><span>{c.hero.footnote}</span><a href="#nosotros">{c.hero.about}<span aria-hidden="true">↓</span></a></div>
            <div class="carousel-navigation" aria-label={c.hero.carouselLabel}>
              <div class="carousel-scene"><span class="carousel-index" data-carousel-index>01</span><span class="carousel-name" data-carousel-name>{c.slides[0].name}</span><span class="carousel-total" aria-hidden="true">/ {String(slides.length).padStart(2,"0")}</span></div>
              <div class="carousel-controls">
                <button data-carousel-prev aria-label={c.hero.previous}><span aria-hidden="true">←</span></button>
                <button data-carousel-pause aria-label={c.hero.pause} aria-pressed="false"><span aria-hidden="true" data-pause-symbol>Ⅱ</span></button>
                <button data-carousel-next aria-label={c.hero.next}><span aria-hidden="true">→</span></button>
              </div>
              <div class="carousel-indicators">{c.slides.map((slide,index) => <button data-slide-button data-slide-name={slide.name} data-slide-caption={slideCaption(index)} aria-label={`${c.hero.slideLabel} ${index + 1}: ${slide.name}`} aria-pressed={index === 0}><span></span></button>)}</div>
              <span class="sr-only" role="status" aria-live="polite" data-carousel-status></span>
            </div>
          </div>
        </div>
        <div class="hero-caption" data-carousel-caption aria-hidden="true">{slideCaption(0)}</div>
      </section>

      <section id="capacidades" class="section shell">
        <div class="section-heading reveal"><div><p class="eyebrow">{c.capabilitiesSection.eyebrow}</p><h2><HeadingLines text={c.capabilitiesSection.title} /></h2></div><p>{c.capabilitiesSection.description}</p></div>
        <div class="capability-grid">{c.capabilities.map(item => <article id={`capacidad-${item.number}`} class="capability-card reveal">
          <div class="card-top"><span class="card-number">{item.number}</span><svg viewBox="0 0 60 60" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.2">{item.icon === "intelligence" ? <><circle cx="30" cy="30" r="9" /><circle cx="30" cy="30" r="22" /><path d="M30 2v19m0 18v19M2 30h19m18 0h19M10 10l14 14m12 12 14 14M10 50l14-14m12-12 14-14" /></> : item.icon === "software" ? <><path d="m30 5 24 13-24 13L6 18 30 5Z" /><path d="m6 29 24 13 24-13M6 40l24 13 24-13M30 31v22" /></> : <><path d="M8 49V11h44v38H8ZM8 24h44M23 24v25M38 24v25" /><circle cx="15" cy="17" r="1" /><circle cx="21" cy="17" r="1" /><path d="m28 39 6-6m-6 0h6v6" /></>}</g></svg></div>
          <h3>{item.title}</h3><p>{item.description}</p>
          <details><summary>{c.capabilitiesSection.explore}<span aria-hidden="true">+</span></summary><ul>{item.items.map(point => <li>{point}</li>)}</ul><a class="text-link" href="#contacto">{c.capabilitiesSection.talk}<span aria-hidden="true">↗</span></a></details>
        </article>)}</div>
      </section>

      <section id="nosotros" class="about-section"><div class="shell about-grid">
        <div class="reveal"><p class="eyebrow">{c.about.eyebrow}</p><h2><HeadingLines text={c.about.title} /></h2></div>
        <div class="reveal"><p class="large-copy">{c.about.lead}</p><p>{c.about.body}</p><a href="#metodo" class="text-link">{c.about.link}<span aria-hidden="true">↗</span></a></div>
        <div class="about-principles">{c.about.principles.map(item => <div><span>{item.title}</span><p>{item.description}</p></div>)}</div>
      </div></section>

      <section id="industrias" class="section shell">
        <div class="section-heading reveal"><div><p class="eyebrow">{c.industriesSection.eyebrow}</p><h2><HeadingLines text={c.industriesSection.title} /></h2></div><p>{c.industriesSection.description}</p></div>
        <div class="industry-layout reveal">
          <div class="industry-tabs" role="tablist" aria-label={c.industriesSection.selector}>{c.industries.map((item,index) => <button id={`industry-tab-${index}`} role="tab" aria-selected={index === 0} aria-controls={`industry-panel-${index}`} tabindex={index === 0 ? 0 : -1} data-industry-tab><span>0{index + 1}</span>{item.name}<span aria-hidden="true">↗</span></button>)}</div>
          <div class="industry-panels">{c.industries.map((item,index) => <div role="tabpanel" id={`industry-panel-${index}`} aria-labelledby={`industry-tab-${index}`} tabindex="0" hidden={index !== 0}>
            <div class="industry-art" aria-hidden="true"><span>{item.symbol}</span><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><small>TAHONA / {item.name.toUpperCase()}</small></div>
            <div class="industry-copy"><h3>{item.title}</h3><p>{item.description}</p><div class="tags">{item.tags.map(tag => <span>{tag}</span>)}</div><a class="text-link" href="#contacto">{c.industriesSection.cta}<span aria-hidden="true">↗</span></a></div>
          </div>)}</div>
        </div>
        <div class="other-industries"><span>{c.industriesSection.otherLabel}</span><p>{c.industriesSection.other}</p></div>
      </section>

      <section id="casos" class="cases-section section"><div class="shell">
        <div class="section-heading reveal"><div><p class="eyebrow">{c.casesSection.eyebrow}</p><h2><HeadingLines text={c.casesSection.title} /></h2></div><p>{c.casesSection.description}</p></div>
        <div class="case-grid">{c.cases.map((item,index) => <article class="case-card reveal">
          <button data-dialog={item.id} class={`case-visual case-visual-${index}`} aria-label={`${c.casesSection.open}: ${item.title}`}><div class="case-diagram" aria-hidden="true">{index === 0 ? <><span class="document doc-one"></span><span class="document doc-two"></span><span class="document doc-three"></span></> : <svg viewBox="0 0 500 240" fill="none"><path d="M-20 170H120V65H255V180H410V90H530M-20 50H60V220H340V30H510" stroke="currentColor" stroke-width="1" /><path d="M40 170H120V65H255V180H410" stroke="currentColor" stroke-width="3" /><circle cx="40" cy="170" r="7" fill="currentColor" /><circle cx="255" cy="65" r="7" fill="currentColor" /><circle cx="410" cy="180" r="7" fill="currentColor" /></svg>}<span class="diagram-label">{c.casesSection.diagramLabels[index]}</span></div><span class="case-open" aria-hidden="true">↗</span></button>
          <div class="case-copy"><p class="eyebrow">{item.sector}</p><h3><button data-dialog={item.id}>{item.title}</button></h3><p>{item.description}</p><button class="text-link" data-dialog={item.id}>{c.casesSection.read}<span aria-hidden="true">↗</span></button></div>
        </article>)}</div>
      </div></section>

      <section id="metodo" class="section shell method-section">
        <div class="section-heading reveal"><div><p class="eyebrow">{c.methodSection.eyebrow}</p><h2><HeadingLines text={c.methodSection.title} /></h2></div><p>{c.methodSection.description}</p></div>
        <div class="method-list">{c.approach.map((item,index) => <details class="reveal" open={index === 0}><summary><span>0{index + 1}</span><h3>{item.title}</h3><span class="expand" aria-hidden="true">+</span></summary><p>{item.description}</p></details>)}</div>
      </section>

      <section id="internacional" class="international-section"><div class="shell international-grid">
        <div class="international-art" aria-hidden="true"><svg viewBox="0 0 500 300"><g fill="none" stroke="currentColor" stroke-width=".6"><ellipse cx="250" cy="150" rx="205" ry="105" /><ellipse cx="250" cy="150" rx="140" ry="105" /><ellipse cx="250" cy="150" rx="70" ry="105" /><path d="M45 150h410M70 100h360M70 200h360M250 45v210" /><path class="connection-line" d="M140 180Q190 25 275 85Q345 120 395 160" stroke-width="1.8" /></g><circle cx="140" cy="180" r="4" fill="currentColor" /><circle cx="275" cy="85" r="4" fill="currentColor" /><circle cx="395" cy="160" r="4" fill="currentColor" /><text x="90" y="210">{c.international.america}</text><text x="265" y="70">{c.international.europe}</text><text x="388" y="190">{c.international.china}</text></svg></div>
        <div class="reveal"><p class="eyebrow">{c.international.eyebrow}</p><h2><HeadingLines text={c.international.title} /></h2><p>{c.international.description}</p><a href="#contacto" class="text-link">{c.international.cta}<span aria-hidden="true">↗</span></a></div>
      </div></section>

      <section id="perspectivas" class="section shell">
        <div class="section-heading reveal"><div><p class="eyebrow">{c.perspectivesSection.eyebrow}</p><h2><HeadingLines text={c.perspectivesSection.title} /></h2></div><p>{c.perspectivesSection.description}</p></div>
        <div class="perspective-grid">{c.perspectives.map((item,index) => <article class="perspective-card reveal"><button data-dialog={item.id} class={`perspective-art art-${item.visual}`} aria-label={`${c.perspectivesSection.read}: ${item.title}`}><span aria-hidden="true">{index === 0 ? "◎" : index === 1 ? "↗" : "⊞"}</span><small aria-hidden="true">{c.perspectivesSection.artLabel}</small></button><p class="eyebrow">{item.category}</p><h3><button data-dialog={item.id}>{item.title}</button></h3><button class="text-link" data-dialog={item.id}>{c.perspectivesSection.read}<span aria-hidden="true">↗</span></button></article>)}</div>
      </section>

      <section id="contacto" class="contact-section section"><div class="shell contact-grid">
        <div class="reveal"><p class="eyebrow">{c.contact.eyebrow}</p><h2><HeadingLines text={c.contact.title} /><br /><span>{c.contact.accent}</span></h2><p>{c.contact.description}</p><a class="contact-email" href="mailto:hola@tahona.ai">hola@tahona.ai<span aria-hidden="true">↗</span></a></div>
        <form class="contact-form reveal" data-form-labels={JSON.stringify(formLabels)} data-status-message={c.contact.status}>
          <h3>{c.contact.formTitle}</h3>
          <div class="form-row"><label>{c.contact.name}<input name="name" autocomplete="name" required placeholder={c.contact.namePlaceholder} maxlength="120" /></label><label>{c.contact.company}<input name="company" autocomplete="organization" required placeholder={c.contact.companyPlaceholder} maxlength="160" /></label></div>
          <label>{c.contact.email}<input name="email" type="email" autocomplete="email" required placeholder={c.contact.emailPlaceholder} maxlength="254" /></label>
          <label>{c.contact.message}<textarea name="message" rows="3" required placeholder={c.contact.messagePlaceholder} maxlength="3000"></textarea></label>
          <p class="form-note">{c.contact.note}</p><button type="submit" class="button button-green" disabled>{c.contact.review}<span aria-hidden="true">↗</span></button><p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div></section>
    </main>
    <footer class="site-footer"><div class="shell">
      <div class="footer-top"><a href="#inicio" class="brand" aria-label={c.nav.home}><span class="brand-mark"><img src="/images/logos/tahona-mark-green.svg" alt="" width="68" height="68" /></span><span>Tahona<span class="brand-ai">AI</span></span></a><p><HeadingLines text={c.footer.tagline} /></p><a href="#inicio" class="back-top">{c.footer.top}<span aria-hidden="true">↑</span></a></div>
      <div class="footer-links"><nav aria-label={c.nav.footerLabel}><a href="#capacidades">{c.nav.capabilities}</a><a href="#industrias">{c.nav.industries}</a><a href="#casos">{c.nav.cases}</a><a href="#perspectivas">{c.nav.perspectives}</a><a href="#nosotros">{c.nav.about}</a><a href="#contacto">{c.nav.contact}</a></nav><a href="mailto:hola@tahona.ai">hola@tahona.ai ↗</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {c.footer.copyright}</span><span>{c.footer.local}</span></div>
      <div class="photo-credits"><a href="https://unsplash.com/photos/modern-glass-building-reflecting-the-cloudy-sky-9dCMJL25DzI" target="_blank" rel="noreferrer">Tanya Barrow / Unsplash</a><span aria-hidden="true">·</span><a href="https://unsplash.com/photos/7aQIAPdxFZQ" target="_blank" rel="noreferrer">krzhck / Unsplash</a><span aria-hidden="true">·</span><a href="https://www.nasa.gov/image-article/apollo-17-blue-marble/" target="_blank" rel="noreferrer">NASA / Apollo 17</a></div>
    </div></footer>
    {c.cases.map(item => <dialog id={item.id} aria-labelledby={`${item.id}-title`}>
      <button class="dialog-close" aria-label={c.casesSection.close}>×</button><p class="eyebrow">{c.casesSection.anonymous} / {item.sector}</p><h2 id={`${item.id}-title`}>{item.title}</h2><h3>{c.casesSection.challenge}</h3><p>{item.challenge}</p><h3>{c.casesSection.solution}</h3><p>{item.solution}</p><div class="dialog-meta">{item.context}</div><a class="button button-green" href="#contacto" data-dialog-link>{c.casesSection.cta}<span aria-hidden="true">↗</span></a>
    </dialog>)}
    {c.perspectives.map(item => <dialog id={item.id} aria-labelledby={`${item.id}-title`}>
      <button class="dialog-close" aria-label={c.perspectivesSection.close}>×</button><p class="eyebrow">{c.perspectivesSection.dialogEyebrow} / {item.category}</p><h2 id={`${item.id}-title`}>{item.title}</h2><p>{item.text}</p><h3>{c.perspectivesSection.threePoints}</h3><ul>{item.points.map(point => <li>{point}</li>)}</ul><a class="text-link" href="#contacto" data-dialog-link>{c.perspectivesSection.cta}<span aria-hidden="true">↗</span></a>
    </dialog>)}
    <dialog id="solicitud" aria-labelledby="solicitud-title"><button class="dialog-close" aria-label={c.request.close}>×</button><p class="eyebrow">{c.request.eyebrow}</p><h2 id="solicitud-title"><HeadingLines text={c.request.title} /></h2><dl id="request-summary"></dl><p class="request-note">{c.request.note}</p><button class="button button-green dialog-close-action">{c.request.back}<span aria-hidden="true">↗</span></button></dialog>
    <script>import "./corporate";</script>
  </body>
</html>
