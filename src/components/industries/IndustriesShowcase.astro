---
import {
  ArrowUpRightIcon,
  ChartLineUpIcon,
  FactoryIcon,
  FirstAidIcon,
  GavelIcon,
  ShieldCheckIcon,
  TruckIcon,
} from "@phosphor-icons/react";
import { INDUSTRY_ITEMS } from "@/components/industries/industry-data";

const INDUSTRY_ICONS = [
  TruckIcon,
  FactoryIcon,
  GavelIcon,
  ShieldCheckIcon,
  ChartLineUpIcon,
  FirstAidIcon,
] as const;

const CARD_BACKGROUNDS = [
  "radial-gradient(circle at 88% 12%, rgba(45,106,79,0.12), transparent 34%), linear-gradient(135deg, rgba(255,255,255,0.96), rgba(241,248,244,0.7))",
  "radial-gradient(circle at 12% 12%, rgba(64,145,108,0.12), transparent 34%), linear-gradient(135deg, rgba(255,255,255,0.96), rgba(247,250,248,0.78))",
  "radial-gradient(circle at 82% 78%, rgba(45,106,79,0.11), transparent 34%), linear-gradient(135deg, rgba(255,255,255,0.96), rgba(241,248,244,0.68))",
] as const;
---

<section id="industrias" class="relative overflow-hidden bg-white py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">Industrias</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        Sectores que trabajamos.
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-500 text-pretty">
        No nos encerramos en un vertical. El patrón común son operaciones con información dispersa, tareas repetibles, documentación e integraciones entre herramientas.
      </p>
    </div>

    <div class="mt-14 grid gap-6 xl:grid-cols-2">
      {INDUSTRY_ITEMS.map((industry, industryIndex) => {
        const Icon = INDUSTRY_ICONS[industryIndex % INDUSTRY_ICONS.length];
        const imageFirst = industryIndex % 2 === 1;

        return (
          <article
            id={industry.id}
            class="group scroll-mt-28 overflow-hidden rounded-[1.75rem] border border-gray-200/80 bg-white/90 p-5 shadow-[0_22px_60px_-46px_rgba(31,31,31,0.42)] transition-[border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-1 hover:border-brand-200 hover:bg-white hover:shadow-[0_30px_72px_-44px_rgba(31,31,31,0.5)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-6"
            style={`background-image: ${CARD_BACKGROUNDS[industryIndex % CARD_BACKGROUNDS.length]};`}
          >
            <div
              class:list={[
                "grid gap-6 lg:items-stretch",
                imageFirst
                  ? "lg:grid-cols-[minmax(13rem,1fr)_minmax(0,2fr)]"
                  : "lg:grid-cols-[minmax(0,2fr)_minmax(13rem,1fr)]",
              ]}
            >
              <div class:list={["flex min-h-0 flex-col", imageFirst && "lg:order-2"]}>
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <span class="flex size-11 items-center justify-center rounded-2xl border border-white/80 bg-white/72 text-brand-700 shadow-sm">
                      <Icon aria-hidden="true" className="size-5" weight="duotone" />
                    </span>
                    <span class="text-sm font-semibold text-brand-700">{industry.marker}</span>
                  </div>
                  <span class="flex size-9 items-center justify-center rounded-full text-gray-700 transition-[background-color,color,transform] duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:bg-brand-50 group-hover:text-brand-700 motion-reduce:transition-none">
                    <ArrowUpRightIcon aria-hidden="true" className="size-4" />
                  </span>
                </div>

                <h3 class="mt-7 font-heading text-2xl font-semibold text-gray-900 text-balance">
                  {industry.title}
                </h3>
                <p class="mt-4 text-base leading-7 text-gray-600 text-pretty">
                  {industry.description}
                </p>

                <ul class="mt-6 grid gap-x-6 gap-y-3 text-sm leading-6 text-gray-600 sm:grid-cols-2">
                  {industry.bullets.map((bullet) => (
                    <li class="grid grid-cols-[0.65rem_1fr] gap-3">
                      <span class="mt-2 size-1.5 rounded-full bg-brand-500"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-auto pt-7">
                  <p class="text-xs font-medium uppercase text-gray-400">
                    Servicios relacionados
                  </p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {industry.relatedServices.map((service) => (
                      <span class="inline-flex items-center gap-2 rounded-full border border-gray-200/85 bg-white/78 px-3 py-1.5 text-xs leading-5 text-gray-700">
                        <span class="size-1.5 rounded-full bg-brand-500"></span>
                        {service}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <div
                aria-hidden="true"
                class:list={[
                  "relative min-h-64 overflow-hidden rounded-[1.45rem] border border-white/80 bg-[radial-gradient(circle_at_22%_18%,rgba(45,106,79,0.15),transparent_32%),radial-gradient(circle_at_78%_76%,rgba(64,145,108,0.13),transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.78),rgba(255,255,255,0.28))] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.82)]",
                  imageFirst && "lg:order-1",
                ]}
              >
                <div class="absolute inset-x-8 top-8 h-px bg-brand-700/10"></div>
                <div class="absolute inset-x-10 bottom-8 h-px bg-brand-700/10"></div>
                <div class="flex h-full min-h-56 items-center justify-center">
                  <div class="relative flex size-28 items-center justify-center rounded-[1.75rem] border border-brand-700/20 bg-white/64 text-brand-700 shadow-[0_24px_54px_-42px_rgba(31,31,31,0.58)] transition-transform duration-200 group-hover:scale-[1.03] motion-reduce:transition-none">
                    <Icon className="size-10" weight="duotone" />
                    <span class="absolute -right-5 top-7 size-7 rounded-xl border border-brand-700/18 bg-white/55"></span>
                    <span class="absolute -bottom-4 left-7 size-5 rounded-full border border-brand-700/18 bg-brand-50/80"></span>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
