---
import {
  ChartLineUpIcon,
  FirstAidIcon,
  ShieldCheckIcon,
} from "@phosphor-icons/react";
import { getIndustryItems } from "@/components/industries/industry-data";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const secondaryIndustries = getIndustryItems(locale).filter(
  (industry) => industry.level === "secondary",
);
const copy = getContent(locale).industriesPage.gridSection;

const INDUSTRY_ICONS = [
  ShieldCheckIcon,
  ChartLineUpIcon,
  FirstAidIcon,
] as const;
---

<section id="otros-contextos" class="relative overflow-hidden bg-white py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-500 text-pretty">
        {copy.description}
      </p>
    </div>

    <div class="mt-12 grid auto-rows-fr gap-4 md:grid-cols-3 lg:gap-5">
      {secondaryIndustries.map((industry, industryIndex) => {
        const Icon = INDUSTRY_ICONS[industryIndex % INDUSTRY_ICONS.length];

        return (
          <article
            id={industry.id}
            data-industry-id={industry.id}
            data-industry-level="secondary"
            class="relative flex min-h-60 flex-col rounded-3xl border border-gray-200/85 bg-surface/60 p-6 sm:p-7"
          >
            {industry.legacyId && (
              <span
                id={industry.legacyId}
                class="absolute inset-x-0 top-0 h-px scroll-mt-28"
                aria-hidden="true"
              ></span>
            )}

            <span class="mb-6 inline-flex size-10 items-center justify-center rounded-xl border border-white bg-white text-brand-700 shadow-sm">
              <Icon aria-hidden="true" className="size-5" weight="duotone" />
            </span>

            <span class="text-sm font-semibold text-brand-700">
              {industry.marker}
            </span>
            <h3 class="mt-3 font-heading text-xl font-semibold text-gray-900 text-balance">
              {industry.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-gray-600 text-pretty">
              {industry.summary}
            </p>

            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              {industry.tags.map((tag) => (
                <span class="rounded-full border border-gray-200 bg-white px-3 py-1 text-xs leading-5 text-gray-500">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
