---
import { getIndustryItems } from "@/components/industries/industry-data";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const industryItems = getIndustryItems(locale);
const copy = getContent(locale).industriesPage.detailSection;
---

<section id="industrias-detalle" class="relative overflow-hidden bg-surface py-24 lg:py-28">
  <div class="section-fade-white-to-surface"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
    </div>

    <div class="mt-16 space-y-16">
      {industryItems.map((industry, industryIndex) => {
        const imageFirst = industryIndex % 2 === 1;

        return (
          <article
            id={industry.id}
            class="scroll-mt-28 border-t border-gray-200 pt-16 first:border-t-0 first:pt-0"
          >
            <div
              class:list={[
                "grid gap-10 lg:items-center lg:gap-14",
                imageFirst
                  ? "lg:grid-cols-[minmax(18rem,1fr)_minmax(0,2fr)]"
                  : "lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]",
              ]}
            >
              <div class:list={[imageFirst && "lg:order-2"]}>
                <p class="text-sm font-semibold text-brand-700">
                  {industry.marker} / 06
                </p>
                <h3 class="mt-5 font-heading text-3xl font-semibold text-gray-900 text-balance">
                  {industry.title}
                </h3>
                <p class="mt-5 max-w-2xl text-base leading-8 text-gray-600 text-pretty">
                  {industry.description}
                </p>

                <ul class="mt-7 grid gap-x-10 gap-y-3 text-sm leading-6 text-gray-600 sm:grid-cols-2">
                  {industry.bullets.map((bullet) => (
                    <li class="grid grid-cols-[0.65rem_1fr] gap-3">
                      <span class="mt-2 size-1.5 rounded-full bg-brand-500"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-8">
                  <p class="text-xs font-medium uppercase text-gray-400">
                    {copy.relatedServicesLabel}
                  </p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {industry.relatedServices.map((service) => (
                      <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white/78 px-3.5 py-1.5 text-xs leading-5 text-gray-700">
                        <span class="size-1.5 rounded-full bg-brand-500"></span>
                        {service}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <div
                class:list={[
                  "relative min-h-72 overflow-hidden rounded-[1.75rem] border border-white/80 bg-[radial-gradient(circle_at_22%_18%,rgba(45,106,79,0.15),transparent_32%),radial-gradient(circle_at_78%_76%,rgba(64,145,108,0.13),transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.78),rgba(255,255,255,0.3))] p-4 shadow-[0_26px_70px_-54px_rgba(31,31,31,0.6),inset_0_1px_0_rgba(255,255,255,0.82)] lg:min-h-[22rem]",
                  imageFirst && "lg:order-1",
                ]}
              >
                <div class="flex h-full min-h-64 items-center justify-center">
                  <img
                    src={industry.visualSrc}
                    alt={industry.visualAlt}
                    class="relative h-full w-full scale-[1.08] object-contain p-3 sm:p-4"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
