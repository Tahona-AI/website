---
import { getContent } from "@/i18n/content";
import {
  DEFAULT_LOCALE,
  getAbsoluteUrl,
  getLanguageAlternates,
  getRouteKeyFromPath,
  LOCALE_DETAILS,
} from "@/i18n/routing";
import type { Locale, RouteKey } from "@/i18n/routing";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  locale?: Locale;
  noindex?: boolean;
  nofollow?: boolean;
  pageKey?: RouteKey;
  type?: "website" | "article" | "product";
}

const {
  title,
  description,
  image = "/og-image.png",
  canonical,
  locale = DEFAULT_LOCALE,
  noindex = false,
  nofollow = false,
  pageKey,
  type = "website",
} = Astro.props;

const routeKey = pageKey ?? getRouteKeyFromPath(Astro.url.pathname);
const content = getContent(locale);
const pageMeta = content.metadata[routeKey];
const resolvedTitle = title ?? pageMeta.title;
const resolvedDescription = description ?? pageMeta.description;
const canonicalURL = canonical || getAbsoluteUrl(locale, routeKey);
const imageURL = new URL(image, Astro.site).href;
const alternates = getLanguageAlternates(routeKey);

const robotsContent = `${noindex ? "noindex" : "index"}, ${nofollow ? "nofollow" : "follow"}`;
---

<!-- Primary Meta Tags -->
<title>{resolvedTitle}</title>
<meta name="title" content={resolvedTitle} />
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonicalURL} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}
<link rel="alternate" hreflang="x-default" href={getAbsoluteUrl(DEFAULT_LOCALE, routeKey)} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={LOCALE_DETAILS[locale].ogLocale} />
<meta property="og:site_name" content="Tahona" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={imageURL} />

<!-- Robots -->
<meta name="robots" content={robotsContent} />

<!-- Additional SEO -->
<meta name="author" content="Tahona" />
<meta
  name="keywords"
  content={content.metadata.keywords}
/>
