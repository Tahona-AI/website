---
import {
  BooksIcon,
  ChartLineUpIcon,
  WrenchIcon,
} from "@phosphor-icons/react";
import { getEngagementModes } from "@/components/services/engagement-modes";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const engagementModes = getEngagementModes(locale);
const copy = getContent(locale).servicesPage.engagementSection;

const ENGAGEMENT_ICONS = {
  "01": BooksIcon,
  "02": WrenchIcon,
  "03": ChartLineUpIcon,
} as const;
---

<section class="relative overflow-hidden bg-white py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-500 text-pretty">
        {copy.description}
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {engagementModes.map((mode) => {
        const Icon = ENGAGEMENT_ICONS[mode.marker];

        return (
          <article
            data-engagement-mode
            class="rounded-[1.5rem] border border-gray-200/85 bg-surface/55 p-6 shadow-sm sm:p-7"
          >
            <div class="flex items-start justify-between gap-4">
              <p class="text-sm font-semibold text-brand-700">{mode.marker}</p>
              <span class="flex size-11 items-center justify-center rounded-2xl border border-white bg-white/80 text-brand-700">
                <Icon aria-hidden="true" className="size-5" weight="duotone" />
              </span>
            </div>

            <h3 class="mt-8 font-heading text-xl font-semibold text-gray-900 text-balance">
              {mode.title}
            </h3>
            <p class="mt-4 text-base leading-7 text-gray-600 text-pretty">
              {mode.description}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</section>
