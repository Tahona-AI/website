---
import { getServiceFamilies } from "@/components/services/service-families";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const serviceFamilies = getServiceFamilies(locale);
const copy = getContent(locale).servicesPage.pillarsSection;
---

<section id="familias-servicios" class="relative overflow-hidden bg-white py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-500 text-pretty">
        {copy.description}
      </p>
    </div>

    <nav class="mt-12 grid gap-5 lg:grid-cols-3" aria-label={copy.title}>
      {serviceFamilies.map((family) => (
        <a
          href={`#${family.id}`}
          class="group flex min-h-64 flex-col rounded-[1.5rem] border border-gray-200/85 bg-surface/55 p-6 transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:border-brand-200 hover:bg-white hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600 motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-7"
        >
          <p class="text-sm font-semibold text-brand-700">{family.marker}</p>
          <h3 class="mt-5 font-heading text-2xl font-semibold text-gray-900 text-balance">
            {family.title}
          </h3>
          <p class="mt-4 text-base leading-7 text-gray-600 text-pretty">
            {family.description}
          </p>
          <span class="mt-auto pt-7 text-sm font-semibold text-brand-700 group-hover:text-brand-600">
            {copy.linkLabel}
          </span>
        </a>
      ))}
    </nav>
  </div>
</section>
