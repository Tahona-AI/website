---
import { SERVICE_FAMILIES } from "@/components/services/service-families";

const FAMILY_CARD_BACKGROUNDS = [
  "radial-gradient(circle at 88% 12%, rgba(45,106,79,0.12), transparent 34%), radial-gradient(circle at 12% 88%, rgba(64,145,108,0.08), transparent 36%)",
  "radial-gradient(circle at 50% 8%, rgba(45,106,79,0.11), transparent 32%), linear-gradient(135deg, rgba(241,248,244,0.82), rgba(255,255,255,0.42) 55%)",
  "radial-gradient(circle at 18% 18%, rgba(45,106,79,0.1), transparent 34%), radial-gradient(circle at 82% 82%, rgba(64,145,108,0.1), transparent 38%)",
] as const;
---

<section id="familias-servicios" class="relative overflow-hidden bg-white py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">Cómo se ordenan los servicios</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        Tres familias de trabajo que se ordenan en una secuencia.
      </h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-500 text-pretty">
        Los Fundamentos entienden y ordenan la operación. El Desarrollo de IA y los Otros desarrollos construyen sobre esa base, no al revés.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {SERVICE_FAMILIES.map((family, familyIndex) => (
        <article
          id={family.id}
          class="group relative flex min-h-[34rem] flex-col overflow-hidden rounded-[1.75rem] border border-gray-200/80 bg-white/88 p-6 shadow-[0_22px_60px_-46px_rgba(31,31,31,0.42)] backdrop-blur-md transition-[border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-1 hover:border-brand-200 hover:bg-white hover:shadow-[0_30px_72px_-44px_rgba(31,31,31,0.5)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-8"
          style={`background-image: ${FAMILY_CARD_BACKGROUNDS[familyIndex]};`}
        >
          <div class="pointer-events-none absolute -right-8 -top-8 h-36 w-36 rounded-full bg-brand-100/45 opacity-0 blur-2xl transition-opacity duration-200 group-hover:opacity-100"></div>

          <div class="relative flex aspect-[1.08] w-full items-center justify-center overflow-hidden rounded-[1.5rem] border border-white/75 bg-[radial-gradient(circle_at_22%_18%,rgba(45,106,79,0.16),transparent_32%),radial-gradient(circle_at_78%_76%,rgba(64,145,108,0.14),transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.78),rgba(255,255,255,0.28))] p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.78)]">
            <img
              src={family.visualSrc}
              alt=""
              aria-hidden="true"
              class:list={[
                "h-full w-full object-contain transition-transform duration-200 ease-out group-hover:scale-[1.04] motion-reduce:transition-none",
                family.visualScaleClass,
              ]}
              loading="lazy"
              decoding="async"
            />
          </div>

          <p class="mt-9 text-sm font-semibold text-brand-700">{family.marker}</p>
          <h3 class="mt-4 font-heading text-2xl font-semibold text-gray-900 text-balance">
            {family.title}
          </h3>
          <p class="mt-4 text-base leading-7 text-gray-600 text-pretty">
            {family.description}
          </p>

          <ol class="mt-auto space-y-3 pt-8">
            {family.services.map((service, serviceIndex) => (
              <li class="grid grid-cols-[1.75rem_1fr] gap-3 text-sm leading-6 text-gray-700">
                <span class="font-semibold text-brand-700">
                  {String(serviceIndex + 1).padStart(2, "0")}
                </span>
                <span>{service.title}</span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </div>
</section>
