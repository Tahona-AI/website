---
import { SERVICE_FAMILIES } from "@/components/services/service-families";
---

<section id="servicios-detalle" class="relative overflow-hidden bg-surface py-24 lg:py-28">
  <div class="section-fade-white-to-surface"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">Servicios en detalle</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        Lo que hacemos, agrupado por familia.
      </h2>
    </div>

    <div class="mt-14 space-y-16">
      {SERVICE_FAMILIES.map((family) => (
        <div class="grid gap-10 border-t border-gray-200 pt-14 first:border-t-0 first:pt-0 lg:grid-cols-[minmax(16rem,0.82fr)_minmax(0,1.8fr)] lg:gap-16">
          <aside class="lg:sticky lg:top-28 lg:self-start">
            <p class="text-sm font-semibold text-brand-700">
              {family.marker} / 03
            </p>
            <h3 class="mt-5 font-heading text-3xl font-semibold text-gray-900 text-balance">
              {family.title}
            </h3>
            <p class="mt-4 max-w-md text-base leading-7 text-gray-600 text-pretty">
              {family.description}
            </p>
            <div class="mt-10 flex min-h-44 items-center justify-center rounded-[1.5rem] border border-white/75 bg-white/55 p-8 shadow-sm lg:bg-transparent lg:shadow-none">
              <img
                src={family.visualSrc}
                alt=""
                aria-hidden="true"
                class:list={[
                  "max-h-40 w-full object-contain",
                  family.visualScaleClass,
                ]}
                loading="lazy"
                decoding="async"
              />
            </div>
          </aside>

          <div class="space-y-4">
            {family.services.map((service) => (
              <article
                id={service.id}
                class="grid gap-7 rounded-[1.5rem] border border-gray-200 bg-white p-6 shadow-sm scroll-mt-28 md:grid-cols-[minmax(0,1fr)_minmax(14rem,0.9fr)] md:p-7 lg:p-8"
              >
                <div>
                  <h4 class="font-heading text-xl font-semibold text-gray-900 text-balance">
                    {service.title}
                  </h4>
                  <p class="mt-4 text-base leading-7 text-gray-600 text-pretty">
                    {service.summary}
                  </p>
                </div>

                <ul class="space-y-3 border-gray-200 text-sm leading-6 text-gray-600 md:border-l md:pl-8">
                  {service.bullets.map((bullet) => (
                    <li class="grid grid-cols-[0.5rem_1fr] gap-3">
                      <span class="mt-2 size-1.5 rounded-full bg-brand-500"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
