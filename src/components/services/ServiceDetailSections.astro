---
import { getServiceFamilies } from "@/components/services/service-families";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const serviceFamilies = getServiceFamilies(locale);
const copy = getContent(locale).servicesPage.detailSection;
---

<section id="servicios-detalle" class="relative overflow-hidden bg-surface py-24 lg:py-28">
  <div class="section-fade-white-to-surface"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 sm:px-10 lg:px-16">
    <div class="max-w-4xl">
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
    </div>

    <div class="mt-14 space-y-16">
      {serviceFamilies.map((family) => (
        <div
          id={family.id}
          class="relative grid scroll-mt-28 gap-10 border-t border-gray-200 pt-14 first:border-t-0 first:pt-0 lg:grid-cols-[minmax(20rem,0.8fr)_minmax(0,2.2fr)] lg:gap-14 xl:gap-16"
        >
          <span
            id={family.legacyId}
            class="absolute inset-x-0 top-0 h-px scroll-mt-28"
            aria-hidden="true"
          ></span>
          <aside class="lg:sticky lg:top-28 lg:self-start">
            <p class="text-sm font-semibold text-brand-700">
              {family.marker} / {String(serviceFamilies.length).padStart(2, "0")}
            </p>
            <h3 class="mt-5 font-heading text-3xl font-semibold text-gray-900 text-balance">
              {family.title}
            </h3>
            <p class="mt-4 max-w-md text-base leading-7 text-gray-600 text-pretty">
              {family.description}
            </p>
            <div class="mt-10 overflow-hidden rounded-[1.75rem] border border-white/75 bg-white/62 p-4 shadow-[0_22px_60px_-48px_rgba(31,31,31,0.45)] backdrop-blur-md">
              <div class="flex aspect-[1.05] w-full items-center justify-center overflow-hidden rounded-[1.45rem] border border-white/75 bg-[radial-gradient(circle_at_24%_18%,rgba(45,106,79,0.16),transparent_32%),radial-gradient(circle_at_76%_78%,rgba(64,145,108,0.14),transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.78),rgba(255,255,255,0.3))] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.76)]">
              <img
                src={family.visualSrc}
                alt=""
                aria-hidden="true"
                class:list={[
                  "h-full w-full object-contain",
                  family.visualScaleClass,
                ]}
                loading="lazy"
                decoding="async"
              />
              </div>
            </div>
          </aside>

          <div class="space-y-4">
            {family.services.map((service) => (
              <article
                id={service.id}
                class="group scroll-mt-28 rounded-[1.5rem] border border-gray-200/85 bg-white/92 p-6 shadow-[0_18px_48px_-42px_rgba(31,31,31,0.45)] transition-[border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[0_28px_66px_-44px_rgba(31,31,31,0.5)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-7 lg:p-8 xl:p-9"
              >
                <div class="grid gap-7 xl:grid-cols-[minmax(0,1.08fr)_minmax(18rem,0.92fr)] xl:gap-10">
                  <div>
                    <h4 class="font-heading text-xl font-semibold text-gray-900 text-balance">
                      {service.title}
                    </h4>
                    <p class="mt-4 text-base leading-7 text-gray-600 text-pretty">
                      {service.summary}
                    </p>
                  </div>

                  <ul class="space-y-3 border-gray-200 text-sm leading-6 text-gray-600 xl:border-l xl:pl-10">
                    {service.bullets.map((bullet) => (
                      <li class="grid grid-cols-[0.65rem_1fr] gap-3">
                        <span class="mt-2 size-1.5 rounded-full bg-brand-500"></span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
