---
import { getServicesFaq } from "@/components/services/services-faq";
import FaqToggleIcon from "@/components/ui/FaqToggleIcon.astro";
import { getContent } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/routing";
import type { Locale } from "@/i18n/routing";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const servicesFaq = getServicesFaq(locale);
const copy = getContent(locale).servicesPage.faqSection;
---

<section class="relative overflow-hidden bg-white py-24 lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 sm:px-10 lg:grid-cols-[minmax(16rem,0.85fr)_minmax(0,1.2fr)] lg:px-16">
    <div>
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300"></span>
        <span class="font-medium text-gray-600">{copy.eyebrow}</span>
      </div>
      <h2 class="mt-4 max-w-xl font-heading text-3xl font-semibold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        {copy.title}
      </h2>
      <p class="mt-5 max-w-md text-base leading-7 text-gray-500 text-pretty">
        {copy.description}
      </p>
    </div>

    <div class="border-t border-gray-200">
      {servicesFaq.map((item, index) => (
        <details class="group border-b border-gray-200 py-6" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-heading text-lg font-semibold text-gray-900 text-balance">
            <span>{item.question}</span>
            <FaqToggleIcon />
          </summary>
          <p class="mt-5 max-w-2xl text-base leading-8 text-gray-600 text-pretty">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
