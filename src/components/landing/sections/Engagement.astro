---
import { DitherIcon, SectionHeading, cardClass, cardHoverClass } from "@/components/landing/primitives";
import { LANDING_SECTIONS, engagement } from "@/components/landing/content";
---

<section id={LANDING_SECTIONS.engagement} class="scroll-mt-20 relative overflow-hidden bg-white py-24 lg:py-28">
  <img
    src="/images/landing/wave-corner.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute -right-24 -top-16 hidden w-[34rem] opacity-70 lg:block"
  />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading {...engagement.heading} />

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        engagement.items.map((mode, index) => (
          <article
            class:list={[cardClass, cardHoverClass, "flex flex-col p-7 sm:p-8"]}
            data-reveal
            style={`--reveal-delay: ${index * 100}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <DitherIcon icon={mode.icon} />
              <span class="text-sm font-semibold text-brand-700">{mode.marker}</span>
            </div>
            <span class="mt-8 w-fit rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
              {mode.tag}
            </span>
            <h3 class="mt-4 font-heading text-2xl font-semibold text-gray-900">{mode.title}</h3>
            <p class="mt-4 text-base leading-7 text-gray-600">{mode.description}</p>
            <div class="mt-auto pt-8">
              <div class="border-t border-gray-200/80 pt-5">
                <p class="text-xs font-semibold uppercase tracking-[0.08em] text-gray-400">{engagement.fitLabel}</p>
                <p class="mt-2 text-sm leading-6 text-gray-700">{mode.fit}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-8 max-w-3xl text-sm leading-6 text-gray-500" data-reveal>{engagement.note}</p>
  </div>
</section>
