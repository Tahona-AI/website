---
import { CheckCircleIcon } from "@phosphor-icons/react";
import { FadeInView } from "@/components/animations/FadeInView";

const results = [
  "80% menos tiempo en tareas administrativas repetitivas",
  "Informes operativos automáticos en segundos, no horas",
  "Cero pérdida de información: todo centralizado y accesible",
  "Alertas automáticas de tareas, plazos y excepciones",
  "Visibilidad completa desde cualquier dispositivo",
  "Integración con tus herramientas actuales sin migraciones",
];
---

<section id="casos" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <FadeInView client:visible>
      <div class="inline-flex items-center gap-3 text-sm text-gray-500">
        <span class="h-px w-10 bg-brand-300" />
        <span class="font-medium text-gray-600">Caso de éxito</span>
      </div>
      <h2 class="mt-4 max-w-4xl font-heading text-3xl font-bold text-gray-900 text-balance sm:text-4xl md:text-5xl">
        De procesos manuales a operativa automatizada en 6 semanas
      </h2>
    </FadeInView>

    <FadeInView client:visible delay={0.2}>
      <div class="mt-16 overflow-hidden rounded-none border border-gray-200 bg-white shadow-sm lg:grid lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div class="flex items-center justify-center border-b border-gray-200 bg-gray-50/50 p-10 sm:p-14 lg:border-b-0 lg:border-r lg:p-16">
          <img
            src="/images/logos/montes_acebo_logo.avif"
            alt="Montes del Acebo"
            width="240"
            height="240"
            class="w-full max-w-[240px] rounded-xl"
          />
        </div>

        <div class="flex flex-col justify-center p-6 text-center sm:p-8 lg:p-12 lg:text-left">
          <div>
            <h3 class="font-heading text-xl font-bold text-gray-900 text-balance">
              Montes del Acebo
            </h3>
            <p class="text-sm text-gray-500">
              Sector alimentación · 40 empleados
            </p>
          </div>

          <div class="mt-6">
            <p class="text-lg font-medium text-gray-900">
              Producción IA que elimina el trabajo manual
            </p>
            <p class="mt-2 text-gray-600 leading-relaxed">
              Pasaron de gestionar operaciones mediante hojas de cálculo dispersas y procesos manuales a tener agentes de IA coordinando flujos entre departamentos. Documentación, seguimiento y reportes, todo automatizado y trazable.
            </p>
            <blockquote class="mt-4 italic text-gray-700 border-l-4 border-brand-500 pl-4">
              "Antes dedicábamos 15 horas semanales a consolidar datos de diferentes fuentes. Ahora el sistema lo hace solo y nos avisa solo cuando hay excepciones."
            </blockquote>
          </div>

          <div class="mt-8 grid gap-2 sm:grid-cols-2">
            {results.map((result) => (
              <div class="flex items-start gap-2">
                <CheckCircleIcon className="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-500" />
                <span class="text-sm text-gray-700">{result}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </FadeInView>
  </div>
</section>
