---
const differentiators = [
  {
    number: "01",
    title: "Equipos con operación diaria",
    description:
      "Encajamos cuando hay procesos reales que sostener, mejorar y medir, no cuando se busca una demostración aislada.",
  },
  {
    number: "02",
    title: "Procesos que se pueden observar",
    description:
      "Trabajamos mejor cuando el equipo puede explicar cómo circulan tareas, datos, documentos y decisiones.",
  },
  {
    number: "03",
    title: "Mejoras conectadas a la operación",
    description:
      "La tecnología es una herramienta. El objetivo es reducir fricción, ordenar información y facilitar el trabajo interno.",
  },
  {
    number: "04",
    title: "Puesta en marcha con el equipo",
    description:
      "Ajustamos con quienes usan las herramientas, medimos en operación real y dejamos una base mantenible.",
  },
] as const;
---

<section class="bg-white py-24 lg:py-28 shrink-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="inline-flex items-center gap-3 text-sm text-gray-500">
      <span class="h-px w-10 bg-brand-300" />
      <span class="font-medium text-gray-600">A quién ayudamos</span>
    </div>
    <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(280px,0.85fr)_minmax(0,1fr)] lg:items-stretch lg:gap-12">
      <div>
        <h2 class="max-w-lg font-heading text-3xl font-bold text-gray-900 text-balance sm:text-4xl md:text-5xl">
          Para equipos con procesos reales que quieren mejorar su operación.
        </h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-gray-600 text-pretty md:text-lg">
          Empezamos por entender cómo trabaja el equipo, qué herramientas usa y dónde una mejora técnica puede aportar sin romper lo que ya funciona.
        </p>
      </div>

      <div class="mx-auto hidden h-full w-full max-w-[320px] lg:block">
        <img
          src="/images/why-tahona-flow.svg"
          alt=""
          aria-hidden="true"
          class="h-full w-full object-contain opacity-[0.98]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="flex h-full flex-col justify-between">
        {differentiators.map((item) => (
          <div>
            <p class="font-heading text-3xl font-semibold text-brand-600 tabular-nums sm:text-4xl">
              .{item.number}
            </p>
            <h3 class="mt-3 max-w-md font-heading text-xl font-semibold text-gray-900 text-balance sm:text-2xl">
              {item.title}
            </h3>
            <p class="mt-2 max-w-md text-base leading-relaxed text-gray-600 text-pretty">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
