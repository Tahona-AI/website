---
const differentiators = [
  {
    number: "01",
    title: "Partner tecnológico, no proveedor puntual",
    description:
      "Tahona acompaña la evolución del sistema, no la entrega de una pieza aislada. Eso permite tomar decisiones con continuidad, ajustar prioridades y construir capacidades que permanecen dentro de la operación.",
  },
  {
    number: "02",
    title: "Entre el SaaS rígido y la consultoría pesada",
    description:
      "Ni obliga a encajar el problema en una herramienta cerrada ni convierte cada avance en un proyecto largo y costoso. El enfoque combina adaptación real con velocidad y control sobre el alcance.",
  },
  {
    number: "03",
    title: "Criterio estratégico y capacidad real de ejecución",
    description:
      "La definición del problema, la priorización y la implementación forman parte del mismo trabajo. La solución no se queda en diagnóstico ni se delega sin contexto a un tercero técnico.",
  },
  {
    number: "04",
    title: "Soluciones diseñadas alrededor del cuello de botella",
    description:
      "Cada sistema se diseña a partir del punto exacto donde la operación pierde tiempo, consistencia o capacidad de respuesta. La tecnología se define en función de esa restricción, no al revés.",
  },
] as const;
---

<section class="bg-white py-24 lg:py-28 shrink-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="inline-flex items-center gap-3 text-sm text-gray-500">
      <span class="h-px w-10 bg-brand-300" />
      <span class="font-medium text-gray-600">Por qué Tahona</span>
    </div>
    <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(280px,0.85fr)_minmax(0,1fr)] lg:items-start lg:gap-12">
      <div>
        <h2 class="max-w-lg font-heading text-3xl font-bold text-gray-900 text-balance sm:text-4xl md:text-5xl">
          Una forma distinta de llevar la IA a la operación
        </h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-gray-600 text-pretty md:text-lg">
          Tahona no parte de una demo ni de una solución cerrada. Parte del problema operativo, entiende el contexto y construye sistemas que encajan en la realidad de la empresa y pueden mantenerse en producción.
        </p>
      </div>

      <div class="mx-auto hidden w-full max-w-[320px] lg:block self-center">
        <img
          src="/images/why-tahona-flow.svg"
          alt=""
          aria-hidden="true"
          class="h-auto w-full opacity-[0.98]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="space-y-8 lg:space-y-10">
        {differentiators.map((item) => (
          <div>
            <p class="font-heading text-3xl font-semibold text-brand-600 tabular-nums sm:text-4xl">
              .{item.number}
            </p>
            <h3 class="mt-3 max-w-md font-heading text-xl font-semibold text-gray-900 text-balance sm:text-2xl">
              {item.title}
            </h3>
            <p class="mt-2 max-w-md text-base leading-relaxed text-gray-600 text-pretty">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
