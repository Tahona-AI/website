---
const differentiators = [
  {
    number: "01",
    title: "Empresas conscientes de la revolución de la IA",
    description:
      "No buscamos convencer a nadie de lo que viene. Solo queremos orientar a las empresas dispuestas a sumarse a esta tecnología.",
  },
  {
    number: "02",
    title: "Procesos bien definidos",
    description:
      "Trabajamos con todos los sectores. Pero es importante que los procesos de la empresa estén bien definidos para ver cuáles se pueden optimizar.",
  },
  {
    number: "03",
    title: "Foco en resultados, la tecnología es un medio",
    description:
      "Buscamos empresas que estén alineadas con el uso de la tecnología para acelerar su crecimiento y adopción tecnológica. No tecnología por tecnología.",
  },
  {
    number: "04",
    title: "Trabajo ágil y cercano",
    description:
      "No nos gusta posponer el trabajo. Buscamos empresas que se sientan cómodas con un trato ágil y cercano. Buscamos resultados en semanas.",
  },
] as const;
---

<section class="bg-white py-24 lg:py-28 shrink-0">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="inline-flex items-center gap-3 text-sm text-gray-500">
      <span class="h-px w-10 bg-brand-300" />
      <span class="font-medium text-gray-600">A quién buscamos</span>
    </div>
    <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(280px,0.85fr)_minmax(0,1fr)] lg:items-stretch lg:gap-12">
      <div>
        <h2 class="max-w-lg font-heading text-3xl font-bold text-gray-900 text-balance sm:text-4xl md:text-5xl">
          Buscamos empresas que quieran aplicar IA con sentido.
        </h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-gray-600 text-pretty md:text-lg">
          Podemos hablar sin compromiso. Estamos comenzando a conocer clientes y buscamos PYMEs en España para descubrir el mercado más a fondo.
        </p>
      </div>

      <div class="mx-auto hidden h-full w-full max-w-[320px] lg:block">
        <img
          src="/images/why-tahona-flow.svg"
          alt=""
          aria-hidden="true"
          class="h-full w-full object-contain opacity-[0.98]"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="flex h-full flex-col justify-between">
        {differentiators.map((item) => (
          <div>
            <p class="font-heading text-3xl font-semibold text-brand-600 tabular-nums sm:text-4xl">
              .{item.number}
            </p>
            <h3 class="mt-3 max-w-md font-heading text-xl font-semibold text-gray-900 text-balance sm:text-2xl">
              {item.title}
            </h3>
            <p class="mt-2 max-w-md text-base leading-relaxed text-gray-600 text-pretty">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
